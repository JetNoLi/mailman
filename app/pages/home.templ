package pages

var mailBoxList = []string{"Inbox", "Spam", "Archived"}

templ Home() {
	<div id="home">
		<div class="home-main-menu">
			<div class="home-main-menu-option">
				<div class="home-main-menu-title"></div>
			</div>
			<div class="home-main-menu-option">
				<div class="home-main-menu-title"></div>
			</div>
		</div>
		<div class="home-side-bar">
			<div class="home-side-menu">
				<div class="home-side-menu-label">
					<p class="home-side-menu-h">Mailbox</p>
				</div>
				<div class="home-side-menu-content">
					for _, mailBox := range mailBoxList {
						<div>{ mailBox }</div>
					}
				</div>
			</div>
			<div class="home-side-menu">
				<div class="home-side-menu-label">
					<p class="home-side-menu-h">Account</p>
				</div>
				<div class="home-side-menu-content">
					<div>
						<p class="home-side-menu-h2">Email:</p>
						<p class="home-side-menu-h2">Imap:</p>
					</div>
				</div>
			</div>
		</div>
	</div>
}
